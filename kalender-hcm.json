{
  "id": "com.custom.kalenderhcm",
  "version": "1.0.2",
  "name": "KalenderHCM",
  "description": "HCM-Anwesenheitskalender mit konfigurierbaren Statusfarben für SAP Analytics Cloud",
  "newInstancePrefix": "KalenderHCM",
  "vendor": "",
  "icon": "https://Mabo2807.github.io/KalenderHCM/icon.png",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-custom-kalenderhcm",
      "url": "https://Mabo2807.github.io/KalenderHCM/src/kalender-hcm.js",
      "integrity": "sha384-CdLD8chMjq+nMwd3klDMflzvw6qdz4nECV15On9FrfBTSyvdfJ8HPxVD3KdzzRkj",
      "ignoreIntegrity": true
    },
    {
      "kind": "builder",
      "tag": "com-custom-kalenderhcm-builder",
      "url": "https://Mabo2807.github.io/KalenderHCM/src/kalender-hcm-builder.js",
      "integrity": "sha384-ve7YLMjllEio3Aou7e2Cd2cqvOGdFYRsJc1DpvCC72ZCtkK5gi0/+OE8VUndx1kh",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-custom-kalenderhcm-styling",
      "url": "https://Mabo2807.github.io/KalenderHCM/src/kalender-hcm-styling.js",
      "integrity": "sha384-rSBlATWWg63x9CAVXhC68LHqqdvnsDZGeEArqjxbc1Aw2Q3ppsAp1/ddD9sgk++w",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "dateColumnId": {
      "type": "string",
      "description": "Technische ID der Datum-Dimension im Datensatz",
      "default": ""
    },
    "statusColumnId": {
      "type": "string",
      "description": "Technische ID der Status-Dimension im Datensatz",
      "default": ""
    },
    "employeeColumnId": {
      "type": "string",
      "description": "Technische ID der Mitarbeiter-Dimension im Datensatz (optional)",
      "default": ""
    },
    "currentDate": {
      "type": "string",
      "description": "Angezeigter Monat als ISO-Datum (YYYY-MM-DD)",
      "default": ""
    },
    "colorScheme": {
      "type": "string",
      "description": "Status-Name → Akzentfarbe als JSON-String z.B. {\"Krank\":\"#e76500\"}",
      "default": "{}"
    },
    "showWeekends": {
      "type": "boolean",
      "description": "Samstag und Sonntag anzeigen",
      "default": true
    },
    "firstDayOfWeek": {
      "type": "integer",
      "description": "Erster Wochentag: 0 = Sonntag, 1 = Montag",
      "default": 1
    },
    "navigationUrl": {
      "type": "string",
      "description": "URL-Template bei Tag-Klick. Platzhalter: {date}, {status}",
      "default": ""
    },
    "openInNewTab": {
      "type": "boolean",
      "description": "Navigation-URL in neuem Tab öffnen",
      "default": true
    }
  },
  "methods": {
    "setMonth": {
      "description": "Zu einem bestimmten Monat navigieren",
      "parameters": [
        {
          "name": "isoDate",
          "type": "string",
          "description": "ISO-Datum-String YYYY-MM-DD"
        }
      ]
    },
    "refresh": {
      "description": "Daten neu laden und Widget neu rendern"
    }
  },
  "events": {
    "onDayClick": {
      "description": "Wird gefeuert wenn ein Tag angeklickt wird. Payload: { date, status }"
    }
  },
  "dataBindings": {
    "attendanceData": {
      "feeds": [
        {
          "id": "dateColumn",
          "description": "Datum-Dimension (YYYY-MM-DD)",
          "type": "dimension"
        },
        {
          "id": "statusColumn",
          "description": "Statuswert (z.B. Krank, Urlaub, Anwesend)",
          "type": "dimension"
        },
        {
          "id": "employeeColumn",
          "description": "Mitarbeitername (optional, für Header-Anzeige)",
          "type": "dimension"
        }
      ]
    }
  }
}
